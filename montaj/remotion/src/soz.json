[
 {
  "start": 0.0,
  "end": 0.9759999999999998,
  "text": "Qabulingizga eng"
 },
 {
  "start": 0.9759999999999998,
  "end": 1.78,
  "text": "og'ir ahvolda"
 },
 {
  "start": 1.78,
  "end": 3.42,
  "text": "kelgan bemorni"
 },
 {
  "start": 3.42,
  "end": 5.17,
  "text": "eslay olasizmi?"
 },
 {
  "start": 5.17,
  "end": 5.561999999999999,
  "text": "Endi ugri"
 },
 {
  "start": 5.561999999999999,
  "end": 6.1899999999999995,
  "text": "kasalligi bilan"
 },
 {
  "start": 6.1899999999999995,
  "end": 7.469999999999999,
  "text": "ko'p kelishadi."
 },
 {
  "start": 7.469999999999999,
  "end": 8.33,
  "text": "Har kuni"
 },
 {
  "start": 8.53,
  "end": 9.472999999999999,
  "text": "ikkita-uchta og'ir"
 },
 {
  "start": 9.472999999999999,
  "end": 9.969999999999999,
  "text": "bemorlar."
 },
 {
  "start": 10.209999999999999,
  "end": 10.536,
  "text": "Endi ular"
 },
 {
  "start": 10.536,
  "end": 10.959999999999999,
  "text": "qanday og'ir"
 },
 {
  "start": 10.959999999999999,
  "end": 11.449,
  "text": "holatga tushib"
 },
 {
  "start": 11.449,
  "end": 11.709999999999999,
  "text": "qoladi:"
 },
 {
  "start": 11.709999999999999,
  "end": 12.997,
  "text": "birovning maslahati"
 },
 {
  "start": 12.997,
  "end": 13.77,
  "text": "bilan \"o'zi"
 },
 {
  "start": 13.77,
  "end": 14.479,
  "text": "o'tib ketadi,"
 },
 {
  "start": 14.479,
  "end": 15.29,
  "text": "tuzalib ketadi\""
 },
 {
  "start": 15.29,
  "end": 16.179,
  "text": "deb kutib-kutib"
 },
 {
  "start": 16.179,
  "end": 16.79,
  "text": "yurishadi."
 },
 {
  "start": 17.11,
  "end": 17.628,
  "text": "Endi biz"
 },
 {
  "start": 17.628,
  "end": 18.55,
  "text": "o'zimiz, o'zbek"
 },
 {
  "start": 18.55,
  "end": 19.73,
  "text": "xalqimiz shunaqaku."
 },
 {
  "start": 19.73,
  "end": 20.837,
  "text": "Kasallikni oldini"
 },
 {
  "start": 20.837,
  "end": 22.19,
  "text": "olmaymiz, keyinchalik"
 },
 {
  "start": 22.19,
  "end": 23.373,
  "text": "asoratlangandan"
 },
 {
  "start": 23.373,
  "end": 24.630000000000003,
  "text": "keyin davolashga"
 },
 {
  "start": 24.630000000000003,
  "end": 26.130000000000003,
  "text": "harakat qilishadi."
 },
 {
  "start": 26.130000000000003,
  "end": 26.93,
  "text": "Ko'p kelishadi."
 },
 {
  "start": 26.93,
  "end": 28.033,
  "text": "Shunaqangi holatlar"
 },
 {
  "start": 28.033,
  "end": 28.53,
  "text": "bo'lgan:"
 },
 {
  "start": 28.53,
  "end": 28.8,
  "text": "ya'ni bir"
 },
 {
  "start": 28.8,
  "end": 29.150000000000002,
  "text": "ayol kelgan,"
 },
 {
  "start": 29.150000000000002,
  "end": 30.253000000000004,
  "text": "o'zini o'ldirmoqchi"
 },
 {
  "start": 30.253000000000004,
  "end": 30.750000000000004,
  "text": "bo'lgan."
 },
 {
  "start": 30.750000000000004,
  "end": 31.735000000000003,
  "text": "Yuzidagi toshmalar"
 },
 {
  "start": 31.735000000000003,
  "end": 32.150000000000006,
  "text": "tufayli"
 },
 {
  "start": 32.53,
  "end": 33.836999999999996,
  "text": "o'ldirmoqchi bo'lgan,"
 },
 {
  "start": 33.836999999999996,
  "end": 34.61,
  "text": "uyidan uksus"
 },
 {
  "start": 34.61,
  "end": 35.23,
  "text": "izlagan ekan."
 },
 {
  "start": 35.37,
  "end": 36.723,
  "text": "Baxtiga uksus"
 },
 {
  "start": 36.723,
  "end": 38.269999999999996,
  "text": "topilmagan ekan"
 },
 {
  "start": 38.269999999999996,
  "end": 39.11,
  "text": "va ertasiga"
 },
 {
  "start": 39.11,
  "end": 40.23,
  "text": "bizning qabulga"
 },
 {
  "start": 40.23,
  "end": 40.79,
  "text": "kelgan."
 },
 {
  "start": 41.03,
  "end": 41.489,
  "text": "Bir 15-20"
 },
 {
  "start": 41.489,
  "end": 42.269999999999996,
  "text": "kunlik lecheniye"
 },
 {
  "start": 42.269999999999996,
  "end": 43.025999999999996,
  "text": "yozib bergandan"
 },
 {
  "start": 43.025999999999996,
  "end": 43.309999999999995,
  "text": "keyin"
 },
 {
  "start": 43.73,
  "end": 45.083999999999996,
  "text": "yuzlarida ancha"
 },
 {
  "start": 45.083999999999996,
  "end": 46.629999999999995,
  "text": "o'zgarish bo'ldi."
 },
 {
  "start": 46.629999999999995,
  "end": 47.245999999999995,
  "text": "O'sha qabulga"
 },
 {
  "start": 47.245999999999995,
  "end": 47.949999999999996,
  "text": "kelgandan keyin"
 },
 {
  "start": 47.949999999999996,
  "end": 49.010999999999996,
  "text": "unga motivatsiya"
 },
 {
  "start": 49.010999999999996,
  "end": 49.51,
  "text": "berdim:"
 },
 {
  "start": 49.51,
  "end": 50.344,
  "text": "\"Opa, bu"
 },
 {
  "start": 50.344,
  "end": 52.29,
  "text": "kasallik tuzaladigan"
 },
 {
  "start": 52.29,
  "end": 53.283,
  "text": "kasallik. O'limgacha"
 },
 {
  "start": 53.33,
  "end": 53.849999999999994,
  "text": "odam o'zini"
 },
 {
  "start": 53.849999999999994,
  "end": 54.75,
  "text": "olib borishi"
 },
 {
  "start": 54.75,
  "end": 55.65,
  "text": "kerak emas.\""
 },
 {
  "start": 55.93,
  "end": 56.75,
  "text": "Hozir"
 },
 {
  "start": 56.75,
  "end": 57.227000000000004,
  "text": "men sizga"
 },
 {
  "start": 57.227000000000004,
  "end": 57.99,
  "text": "oddiy lecheniye"
 },
 {
  "start": 57.99,
  "end": 58.730000000000004,
  "text": "yozib beraman,"
 },
 {
  "start": 58.870000000000005,
  "end": 59.510000000000005,
  "text": "shuni qilsangiz"
 },
 {
  "start": 59.510000000000005,
  "end": 60.07,
  "text": "agar, tuzalib"
 },
 {
  "start": 60.07,
  "end": 60.804,
  "text": "ketasiz. Haqiqatan"
 },
 {
  "start": 60.804,
  "end": 61.19,
  "text": "ham hozir"
 },
 {
  "start": 61.19,
  "end": 61.456,
  "text": "mana biz"
 },
 {
  "start": 61.456,
  "end": 61.81,
  "text": "ikkinchi oy"
 },
 {
  "start": 61.81,
  "end": 62.43300000000001,
  "text": "lecheniyasidamiz,"
 },
 {
  "start": 62.43300000000001,
  "end": 63.022000000000006,
  "text": "bemorning yuzida"
 },
 {
  "start": 63.022000000000006,
  "end": 63.61,
  "text": "umuman qolmagan."
 },
 {
  "start": 63.849999999999994,
  "end": 64.81,
  "text": "Hozir o'sha"
 },
 {
  "start": 65.01,
  "end": 65.681,
  "text": "holatlarni aytib"
 },
 {
  "start": 65.681,
  "end": 66.43,
  "text": "beradigan bo'lsam,"
 },
 {
  "start": 66.43,
  "end": 67.358,
  "text": "o'zlariga, o'zlari"
 },
 {
  "start": 67.358,
  "end": 68.09,
  "text": "ham kuladilar."
 }
]